        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {\r",
                  "  const res = pm.response.json();\r",
                  "  pm.environment.set('access_token', res.data.accessToken);\r",
                  "  pm.environment.set('refresh_token', res.data.refreshToken);\r",
                  "  pm.environment.set('user_id', res.data.user.id);\r",
                  "  console.log('Tokens saved from register');\r",
                  "}\r",
                  "\r",
                  "pm.test('Status is 201', () => {\r",
                  "  pm.response.to.have.status(201);\r",
                  "});\r",
                  "pm.test('Has access token', () => {\r",
                  "  const res = pm.response.json();\r",
                  "  pm.expect(res.data.accessToken).to.be.a('string');\r",
                  "});\r",
                  "pm.test('Success is true', () => {\r",
                  "  pm.expect(pm.response.json().success).to.be.true;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
